graph LR
  %% the chunks of aquamaps_eov.qmd, the tables and files they make, and the env flags.

  subgraph in[Inputs, read only]
    spp[("spp.duckdb<br/>worms, iucn_redlist")]:::source
    sdm[("v9/sdm.duckdb<br/>cell, taxon")]:::source
    reg["v9 registry/taxon_model.parquet"]:::source
    parts["v9 dist/dataset=am<br/>dist/dataset=rng_iucn<br/>(one parquet per model)"]:::source
    tpl["r_cellid_global.tif"]:::source
  end

  subgraph taxa[Chunk: taxa]
    tree["eov_tree_sql<br/>EOV x AphiaID"]:::step
    mapt["am model map<br/>range map, Red List<br/>weights"]:::step
  end

  subgraph dist[Chunk: distributions - batched, restartable]
    bat["batches: species by EOV x row cap<br/>never split, never mixed"]:::step
    perb["per batch<br/>rng_b - clip_b - tot_b"]:::step
    part[("partials/totals/batch_N.parquet<br/>partials/cell_eov/batch_N.parquet<br/>both files = batch done")]:::artifact
    ce[("eov_sp_total<br/>eov_cell_eov<br/>share, risk")]:::artifact
    cs1[("cs_partials/batch_N/band=b<br/>stage 1: cell, species, suit")]:::artifact
  end

  subgraph csp[Chunks: cell_species and species]
    cs2["stage 2: per 5 degree band<br/>sort, write 72 tiles<br/>cell_species_check"]:::step
    lk["species lookup<br/>common name, sp_key, links"]:::step
  end

  subgraph agg[Chunk: aggregate]
    sc["densities, q99<br/>scores, composite, n_eov"]:::step
  end

  subgraph out[Chunk: outputs - staging dir]
    cog["score_[risk,share].tif (Byte)<br/>density_[risk,share].tif (Float32)"]:::artifact
    pq["cells/eov=[g]/data.parquet<br/>h3_r5.parquet<br/>eov_taxa.parquet"]:::artifact
    meta["eov_summary.csv<br/>method.json<br/>provenance.json<br/>README.md, AGENTS.md"]:::artifact
    tiles["cell_species/tile=[t]/data_0.parquet<br/>species.parquet"]:::artifact
    stac["collection.json<br/>items/[eov]_[metric].json (16)"]:::artifact
  end

  ver["Chunk: verify_stac<br/>EOV_VERIFY_N species<br/>COG vs partition"]:::step
  up["Chunk: upload<br/>aws s3 sync --delete<br/>EOV_S3=1 only"]:::surface
  s3[("s3://oceanmetrics.io-public<br/>/atlas/aquamaps_eov/")]:::surface

  spp --> tree --> mapt
  reg --> mapt
  mapt --> bat --> perb
  sdm --> perb
  parts --> perb
  perb --> part --> ce
  perb -. "EOV_CELL_SPECIES" .-> cs1 --> cs2 --> tiles
  ce --> lk --> tiles
  tiles --> stac
  ce --> sc
  sdm --> sc
  tpl --> cog
  sc --> cog & pq & meta
  cog --> stac
  pq --> stac
  meta --> stac
  parts -.-> ver
  ver -.-> stac
  stac --> up --> s3

  flags["EOV_REDO, EOV_TEST_N, EOV_BATCH_ROWS,<br/>EOV_CELL_SPECIES, EOV_WEIGHTS, EOV_Q, EOV_VERIFY_N, EOV_S3,<br/>MSENS_DERIVED, BUILD_MEMORY_GB, BUILD_THREADS, BUILD_TMP_GB"]:::note
  flags ~~~ in

  classDef source   fill:#f5f0e6,stroke:#8a8272,color:#182b49
  classDef step     fill:#fff7d6,stroke:#c9a227,color:#182b49
  classDef artifact fill:#fbe9c9,stroke:#d97706,color:#182b49
  classDef surface  fill:#e6f2fb,stroke:#00629b,color:#182b49
  classDef note     fill:#ffffff,stroke:#cfd6de,color:#52607a,stroke-dasharray:4 3
  style in    fill:#fafafa,stroke:#cfd6de
  style taxa  fill:#fafafa,stroke:#cfd6de
  style dist  fill:#fafafa,stroke:#cfd6de
  style csp   fill:#fafafa,stroke:#cfd6de
  style agg   fill:#fafafa,stroke:#cfd6de
  style out   fill:#fafafa,stroke:#cfd6de
